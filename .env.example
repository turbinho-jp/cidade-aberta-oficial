# Copie para .env (desenvolvimento local) ou cadastre estas variáveis no painel da Vercel.
# NUNCA commite o arquivo .env.

# Neon: use a connection string "pooled" (host com "-pooler"), com ?sslmode=require
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Gere com: openssl rand -hex 32
SESSION_SECRET=

# Opcional (valores padrão entre parênteses)
# DB_POOL_MAX=5                          conexões por instância
# MAX_ATTACHMENT_BYTES=1000000           tamanho máximo de cada foto (1 MB)
# MAX_ATTACHMENTS_PER_ITEM=5             fotos por demanda/obra
# MAX_UPLOADS_PER_HOUR=30                envios por usuário por hora
# MAX_ATTACHMENTS_TOTAL_BYTES=350000000  teto de fotos no banco (Neon grátis = 512 MB)
# CORS_ORIGIN=                           só se o frontend ficar em outro domínio
# LOG_LEVEL=info

# Só no desenvolvimento local (API em outra porta)
# PORT=8080
